{
  "name": "art-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "CF_LOCAL=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply art-lab --local",
    "db:migrate:remote": "wrangler d1 migrations apply art-lab --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.34",
    "@ai-sdk/react": "^4.0.160",
    "@cloudflare/ai-chat": "^0.12.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@genart-api/core": "^0.33.2",
    "@uiw/react-codemirror": "^4.25.12",
    "agents": "^0.31.0",
    "ai": "^7.0.156",
    "hono": "^4.13.14",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.155.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "core-js-pure": false
  }
}
