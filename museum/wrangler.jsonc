{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "art-museum",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "upload_source_maps": true,
  // Public. Keep art.kacperochnik.eu in the Access app until the museum opens (docs/museum-plan.md §12).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "art.kacperochnik.eu", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The lab's database and bucket. The museum only reads exhibits and the public museum/ prefix.
  "d1_databases": [
    { "binding": "DB", "database_name": "art-lab", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "../migrations" }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "art-lab-outputs" }],
  "vars": {
    // Changing it rehangs the whole museum.
    "LAYOUT_SEED": "art-museum-1"
  },
  "observability": { "enabled": true }
}
