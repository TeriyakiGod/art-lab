{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "art-lab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // Only reachable through the Access-protected custom domain
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "lab.art.kacperochnik.eu", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "art-lab", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "art-lab-outputs" }],
  "durable_objects": {
    "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "teriyakigod.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_AUD",
    "AI_GATEWAY_ID": "default"
  },
  "observability": { "enabled": true }
}
